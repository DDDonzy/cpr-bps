{
  "manifestVersion": 2,
  "publisher": "donzy",
  "name": "excel-bps",
  "displayName": "Excel / Basis Points",
  "version": "0.10.0",
  "description": "BPS account and model routing with selectable failure policy and route logs.",
  "engines": {
    "codex-proxy-rs": ">=3.18.2, <3.19.0"
  },
  "main": "bin/cpr-bps-plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "upstream_adapter": {
      "version": 1,
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "middleware": {
      "version": 3,
      "stages": [
        "request"
      ],
      "inputFormats": [
        "openai"
      ],
      "outputFormats": [
        "openai"
      ]
    },
    "management": {
      "version": 1
    },
    "scheduler": {
      "version": 1
    }
  },
  "configurationSchema": {
    "type": "object",
    "default": {
      "enabled": true,
      "accountIds": [],
      "models": [
        "gpt-6-luna",
        "gpt-6-astra",
        "gpt-6-sol"
      ],
      "timeoutMs": 3600000,
      "onFailure": "native_fallback"
    },
    "patternProperties": {
      "^enabled$": {
        "type": "boolean"
      },
      "^accountIds$": {
        "type": "array",
        "maxItems": 200,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "^models$": {
        "type": "array",
        "maxItems": 256,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "^timeoutMs$": {
        "type": "integer",
        "minimum": 60000,
        "maximum": 14400000
      },
      "^onFailure$": {
        "type": "string",
        "enum": [
          "reject",
          "native_fallback"
        ]
      }
    },
    "additionalProperties": false
  },
  "license": "UNLICENSED",
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "application/javascript",
    "web/style.css": "text/css",
    "web/THIRD_PARTY_NOTICES.txt": "text/plain"
  },
  "state": [
    {
      "namespace": "bps.routes",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": [
          "entries"
        ],
        "properties": {
          "entries": {
            "type": "array",
            "maxItems": 64
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 128,
      "maximumBytes": 4194304,
      "maximumValueBytes": 32768
    }
  ]
}
