[Unit]
Description=BPS usage log display gateway
After=network.target docker.service

[Service]
DynamicUser=yes
ExecStart=/opt/cpr-bps-log-gateway/bps-log-gateway --listen 127.0.0.1:18901 --upstream http://127.0.0.1:8080 --public-origin https://us.cpr.dddonzy.xyz --instance 1810791f-c16b-8e48-b9d2-77b7d13315f0
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6
MemoryMax=128M
TasksMax=64

[Install]
WantedBy=multi-user.target
